<section class="eccf-reset-window-content">
  <p>{{localize "ECCF.WindowGeometry.ResetExplanation"}}</p>
  <p class="hint">{{localize "ECCF.WindowGeometry.ResetHint"}}</p>
  <footer>
    <button type="button" data-action="reset">
      <i class="fa-solid fa-window-restore"></i>
      {{localize "ECCF.WindowGeometry.ResetButton"}}
    </button>
    <button type="button" data-action="cancel">
      <i class="fa-solid fa-xmark"></i>
      {{localize "ECCF.WindowGeometry.Cancel"}}
    </button>
  </footer>
</section>
